# Our own nftables table (never a flush of the ruleset; RHV and TQC rules untouched). Installed by setup-vm.sh as
# /etc/vaidyx-tb/vaidyx.nft (@WWW_UID@ replaced with www-data's uid). Only nginx (www-data) and root may connect to the
# link's two localhost ports; every other local user on the shared VM is refused.
table inet vaidyx
delete table inet vaidyx
table inet vaidyx {
    chain output {
        type filter hook output priority 0; policy accept;
        # Only a NEW connection (the opening SYN, always sent from a socket with its owner) is checked. Packets the kernel
        # sends without an owner (the last ACK after nginx closes) must pass, or the link's end is left half-closed and
        # later connections time out (seen 4 Nov: 503s while a page loaded its scripts).
        ip daddr 127.0.0.1 tcp dport { 970, 17999 } tcp flags & (syn | ack) == syn meta skuid != { 0, @WWW_UID@ } counter reject with tcp reset
    }
}
