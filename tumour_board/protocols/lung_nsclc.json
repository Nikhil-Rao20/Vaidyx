{
 "id": "lung_nsclc", "label": "Lung cancer (NSCLC)", "version": "0.2",
 "note": "Configurable by the clinical team. Prototype defaults informed by NCCN/ESMO/NCG workup lists and CAP biomarker templates; to be confirmed by the hospital Tumour Board.",
 "mandatory": [
  {"id": "clinical_history", "label": "Clinical history and performance status", "doc_types": ["clinical_note", "referral"], "department": "Medical Oncology", "required_facts": ["ecog", "clinical_question"], "sla_days": 2},
  {"id": "ct_thorax", "label": "Diagnostic CT thorax report", "doc_types": ["ct"], "region": "thorax|chest|lung", "department": "Radiology", "required_facts": ["lesion_size"], "sla_days": 3},
  {"id": "pet_ct", "label": "PET/CT staging report", "doc_types": ["pet_ct"], "department": "Nuclear Medicine", "required_facts": ["recorded_stage"], "sla_days": 5},
  {"id": "brain_mri", "label": "Brain MRI (staging)", "doc_types": ["mri"], "region": "brain|head|cranial", "department": "Radiology", "required_facts": [], "sla_days": 5},
  {"id": "histopathology", "label": "Histopathology report", "doc_types": ["histopathology"], "department": "Pathology", "required_facts": ["histologic_type"], "sla_days": 5},
  {"id": "pdl1", "label": "PD-L1 result", "facts_only": true, "fact_doc_types": ["histopathology", "ihc", "molecular"], "department": "Pathology", "required_facts": ["pdl1"], "sla_days": 7},
  {"id": "driver_mutations", "label": "Molecular results (EGFR / ALK / ROS1)", "facts_only": true, "fact_doc_types": ["molecular", "histopathology", "ihc"], "department": "Molecular Pathology", "required_facts": ["egfr", "alk", "ros1"], "sla_days": 10},
  {"id": "baseline_labs", "label": "Baseline blood tests", "doc_types": ["lab"], "department": "Laboratory Medicine", "required_facts": ["haemoglobin", "wbc", "platelets", "creatinine"], "sla_days": 2}
 ],
 "optional": [
  {"id": "prior_imaging", "label": "Previous imaging for comparison", "doc_types": ["ct", "xray", "pet_ct"], "department": "Radiology"},
  {"id": "pft", "label": "Pulmonary function tests", "doc_types": ["pulmonary_function"], "department": "Pulmonology"},
  {"id": "discharge", "label": "Discharge summary", "doc_types": ["discharge_summary"], "department": "Medicine"},
  {"id": "previous_board", "label": "Previous Tumour Board record", "doc_types": ["tumour_board_record"], "department": "Tumour Board coordinator"}
 ],
 "extract_facts": ["ecog", "smoking_history", "comorbidities", "clinical_question", "recorded_stage", "lesion_size", "nodal_findings", "distant_findings", "comparison_prior", "suv_max",
                   "histologic_type", "pdl1", "egfr", "alk", "ros1", "kras", "haemoglobin", "wbc", "platelets", "creatinine", "bilirubin", "treatment_received"],
 "post_board": {"required_record_fields": ["decision_text", "recorded_by", "actions"], "follow_up_default_days": 14}
}
