 "statements": [
  {
   "text": "In the ADAURA trial, adjuvant osimertinib significantly improved disease-free survival (DFS) in patients with resected stage IB to IIIA EGFR-mutated NSCLC compared to placebo, with a hazard ratio of 0.20 (99.12% CI, 0.14 to 0.30).",
   "citations": [
    {
     "pmid": "32955177",
     "quote": "In the overall population, 89% of the patients in the osimertinib group (95% CI, 85 to 92) and 52% of those in the placebo group (95% CI, 46 to 58) were alive and disease-free at 24 months (overall hazard ratio for disease recurrence or death, 0.20; 99.12% CI, 0.14 to 0.30; P<0.001).",
     "where": "RESULTS"
    }
   ]
  },
  {
   "text": "Updated ADAURA results showed a 4-year DFS rate of 73% for osimertinib versus 38% for placebo in the overall population.",
   "citations": [
    {
     "pmid": "36720083",
     "quote": "In the overall population, DFS HR was 0.27 (95% CI, 0.21 to 0.34); 4-year DFS rate was 73% (osimertinib) and 38% (placebo).",
     "where": "RESULTS"
    }
   ]
  },
  {
   "text": "A meta-analysis of nine RCTs reported that first-, second-, and/or third-generation EGFR TKIs may improve DFS compared to placebo/BSC, though the evidence is very uncertain (HR 0.34, 95% CI 0.28 to 0.41).",
   "citations": [
    {
     "pmid": "40421698",
     "quote": "TKIs may improve disease-free survival compared to placebo/BSC, but the evidence is very uncertain (HR 0.34, 95% CI 0.28 to 0.41; 5 studies, 1153 participants).",
     "where": "MAIN RESULTS"
    }
   ]
  },
  {
   "text": "The same meta-analysis found that EGFR TKIs may have improved DFS compared to chemotherapy (HR 0.54, 95% CI 0.35 to 0.83).",
   "citations": [
    {
     "pmid": "40421698",
     "quote": "TKIs may have improved disease-free survival compared to chemotherapy (HR 0.54, 95% CI 0.35 to 0.83; 4 studies, 878 participants; low-certainty evidence).",
     "where": "MAIN RESULTS"
    }
   ]
  }
