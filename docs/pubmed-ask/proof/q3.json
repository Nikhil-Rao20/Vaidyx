  "years": null,
  "translation": "(\"induction chemotherapy\"[All Fields] OR \"neoadjuvant chemotherapy\"[All Fields]) AND (\"chemoradiation\"[All Fields] OR \"chemoradiotherapy\"[All Fields]) AND (\"locally advanced cervical cancer\"[All Fields] OR \"cervical neoplasia\"[All Fields])"
 },
 "statements": [
  {
   "text": "A phase 3 trial reported that short-course induction chemotherapy followed by chemoradiotherapy significantly improved 5-year progression-free survival (72% vs 64%) and overall survival (80% vs 72%) compared to chemoradiotherapy alone.",
   "citations": [
    {
     "pmid": "39419054",
     "quote": "After a median follow-up of 67 months, 5-year progression-free survival rates were 72% in the induction chemotherapy with chemoradiotherapy group and 64% in the chemoradiotherapy alone group with a hazard ratio (HR) of 0\u00b765 (95% CI 0\u00b746-0\u00b791, p=0\u00b7013). 5-year overall survival rates were 80% in the induction chemotherapy with chemoradiotherapy group and 72% in the chemoradiotherapy alone group, with an HR of 0\u00b760 (95% CI 0\u00b740-0\u00b791, p=0\u00b7015).",
     "where": "FINDINGS"
    }
   ]
  },
  {
   "text": "A meta-analysis found that adding induction chemotherapy to chemoradiotherapy significantly improves progression-free survival and overall survival, provided the induction chemotherapy is a platinum doublet with paclitaxel administered within 6 weeks.",
   "citations": [
    {
     "pmid": "40408847",
     "quote": "In patients with LACC, ICT + CCRT significantly improves PFS and OS compared to CCRT alone, provided that the ICT involves a platinum doublet with paclitaxel and is administered within \u2264 6 weeks.",
     "where": "CONCLUSION"
    }
   ]
  },
  {
   "text": "A report on 50 patients receiving weekly cisplatin and paclitaxel followed by chemoradiation showed a 3-year overall survival rate of 83.9% and a 3-year progression-free survival rate of 73.6%.",
   "citations": [
    {
     "pmid": "36641433",
     "quote": "After a median follow-up of 28 months, the 3-year OS rate was 83.9%, and the 3-year PFS rate was 73.6%.",
     "where": "RESULTS"
    }
   ]
  },
  {
   "text": "The addition of induction chemotherapy to chemoradiation did not adversely impact quality of life compared to chemoradiation alone.",
   "citations": [
    {
     "pmid": "40139003",
     "quote": "IC added to CRT does not adversely impact QoL compared to CRT, either during IC, during CRT or later.",
     "where": "CONCLUSION"
    }
   ]
  }
 ],
