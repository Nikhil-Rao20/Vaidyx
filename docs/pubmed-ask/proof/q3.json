{
 "question": "What did trials report about induction chemotherapy before chemoradiation in locally advanced cervical cancer?",
 "label": "From PubMed. Every line is quoted word for word from the paper's abstract. Published evidence, not advice for any patient.",
 "status": "answered",
 "message": "",
