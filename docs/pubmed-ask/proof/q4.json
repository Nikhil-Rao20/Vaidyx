 "statements": [
  {
   "text": "A randomized phase III trial in India found that triple metronomic chemotherapy (TMC) significantly improved survival outcomes compared to physician choice therapy in platinum-refractory head and neck cancer.",
   "citations": [
    {
     "pmid": "40209850",
     "quote": "These results suggest that TMC significantly improves survival outcomes over physician choice therapy in platinum-refractory head and neck cancer.",
     "where": "Abstract"
    }
   ]
  },
  {
   "text": "A randomized phase III superiority study reported that adding low-dose nivolumab to triple metronomic chemotherapy improved 1-year overall survival from 16.3% to 43.4%.",
   "citations": [
    {
     "pmid": "36265101",
     "quote": "The addition of low-dose nivolumab led to an improvement in the 1-year OS from 16.3% (95% CI, 8.0 to 27.4) to 43.4% (95% CI, 30.8 to 55.3; hazard ratio, 0.545; 95% CI, 0.362 to 0.820; P = .0036).",
     "where": "RESULTS"
    }
   ]
  },
  {
   "text": "A retrospective analysis of 340 patients found that oral metronomic chemotherapy had promising results in selected cohorts, but dismal results for those who failed within 6 months of previous treatment.",
   "citations": [
    {
     "pmid": "29199656",
     "quote": "Oral metronomic chemotherapy has promising results when used in a selected cohort of patients but has dismal results in patients who failed within 6 months of previous treatment.",
     "where": "CONCLUSION"
    }
   ]
  }
 ],
