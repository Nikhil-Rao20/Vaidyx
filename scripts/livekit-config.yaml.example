# LiveKit server configuration for Vaidyx-TB meetings (localhost only).
# scripts/livekit.sh copies this file to /data/vaidyx/tools/livekit/config.yaml and fills in the API key and secret from
# data/tumour_board/livekit.json (the two placeholders in the keys block below); never commit a filled copy. Comment lines are dropped.
port: 7880
bind_addresses:
  - 127.0.0.1
rtc:
  # media on the loopback address: UDP 50000 to 50200 for browsers on this server, and TCP 7881 so a laptop that reaches the
  # server through an ssh or VS Code tunnel (localhost:7880 and localhost:7881 forwarded) also gets audio and video (18 Oct)
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50200
  use_external_ip: false
  node_ip: 127.0.0.1
  enable_loopback_candidate: true
  ips:
    includes:
      - 127.0.0.1/32
keys:
  __API_KEY__: __API_SECRET__
logging:
  level: warn
  json: false
room:
  auto_create: true
  empty_timeout: 300
  max_participants: 50
