les": [], "code_blocks": [], "meta_description": "Non-nutritive artificial sweeteners (NNSs) may have the ability to change the gut microbiota, which could potentially alter glucose metabolism. This study aimed to determine the effect of sucralose and aspartame consumption on gut microbiota composition using realistic doses of NNSs. Seventeen healt \u2026", "meta_keywords": "pmid:33171964, PMC7694690, doi:10.3390/nu12113408, Randomized Controlled Trial, Samar Y Ahmad, James Friel, Dylan Mackay, Adolescent, Adult, Analysis of Variance, Aspartame / pharmacology*, Biodiversity, Cross-Over Studies, Double-Blind Method, Fatty Acids, Volatile / metabolism, Feces / microbiology, Female, Gastrointestinal Microbiome / drug effects*, Health*, Humans, Male, Metabolomics, Middle Aged, Non-Nutritive Sweeteners / pharmacology*, Phylogeny, Principal Component Analysis, Sucrose / analogs & derivatives*, Sucrose / pharmacology, Treatment Outcome, Young Adult, PubMed Abstract, NIH, NLM, NCBI, National Institutes of Health, National Center for Biotechnology Information, National Library of Medicine, MEDLINE", "og_image": "https://cdn.ncbi.nlm.nih.gov/pubmed/persistent/pubmed-meta-image-v2.jpg", "js_rendered": true, "js_message": "Page appears to be rendered by a JavaScript framework; content may be incomplete.", "success": true, "error": "", "truncated": false, "fetched_bytes": 194547, "total_bytes": 194547}}